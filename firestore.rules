rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'language', 'createdAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.language in ['en', 'ur']
        && data.createdAt == request.time;
    }

    function isValidDetection(data) {
      return data.keys().hasAll(['userId', 'cropType', 'imageUrl', 'status', 'diseaseName', 'confidence', 'recommendations', 'createdAt'])
        && data.keys().size() == 8
        && data.userId == request.auth.uid
        && data.cropType in ['potato', 'tomato', 'strawberry', 'blueberry', 'orange', 'corn']
        && data.imageUrl is string && data.imageUrl.size() < 2048
        && data.status in ['healthy', 'diseased']
        && data.diseaseName is string && data.diseaseName.size() <= 256
        && data.confidence is number && data.confidence >= 0 && data.confidence <= 1
        && data.recommendations is string && data.recommendations.size() <= 5000
        && data.createdAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language'])
        && incoming().displayName is string && incoming().displayName.size() <= 128
        && incoming().language in ['en', 'ur']
      );
    }

    match /detections/{detectionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(detectionId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(detectionId) && isValidDetection(incoming());
      allow delete: if isSignedIn() && isValidId(detectionId) && resource.data.userId == request.auth.uid;
    }
  }
}
